# Host Ports
CKAN_PORT_HOST=5000
DB_PORT_HOST=5432
MARTIN_PORT_HOST=3000
PREFECT_PORT_HOST=4200
NGINX_PORT_HOST=81
NGINX_SSLPORT_HOST=8443

# CKAN databases
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=db
CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore

# Read-only connection for the `tiles` (martin) service; see martin/config.yaml
MAPS_DATABASE_URL=postgresql://maps_ro:CHANGE_ME@db/maps

# Prefect server's own database (the `prefect` service in docker-compose.yml). Point this
# at a dedicated `prefect` database on the same Postgres CKAN uses -- create it once with
# `CREATE DATABASE prefect;` (dev's db container does this via
# postgresql/docker-entrypoint-initdb.d/60_create_prefect.sh); Prefect runs its own
# migrations on start. Must use the asyncpg driver.
PREFECT_DATABASE_URL=postgresql+asyncpg://ckandbuser:ckandbpassword@db/prefect

# Test database connections

TEST_CKAN_SQLALCHEMY_URL=postgres://ckan:ckan@db/ckan_test
TEST_CKAN_DATASTORE_WRITE_URL=postgresql://ckan:ckan@db/datastore_test
TEST_CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore_test

# Dev settings
USE_HTTPS_FOR_DEV=false

# CKAN core
CKAN_VERSION=2.12.0
CKAN_SITE_ID=default
CKAN_SITE_URL=https://localhost:8443
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME
# See https://docs.ckan.org/en/latest/maintaining/configuration.html#api-token-settings
CKAN___API_TOKEN__JWT__ENCODE__SECRET=string:CHANGE_ME
CKAN___API_TOKEN__JWT__DECODE__SECRET=string:CHANGE_ME
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=test1234
CKAN_SYSADMIN_EMAIL=your_email@example.com
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN_SMTP_SERVER=smtp.corporateict.domain:25
CKAN_SMTP_STARTTLS=True
CKAN_SMTP_USER=user
CKAN_SMTP_PASSWORD=pass
CKAN_SMTP_MAIL_FROM=ckan@localhost
CKAN_MAX_UPLOAD_SIZE_MB=100
TZ=UTC

# Solr
SOLR_IMAGE_VERSION=2.12-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan
TEST_CKAN_SOLR_URL=http://solr:8983/solr/ckan

# Redis
REDIS_VERSION=6
CKAN_REDIS_URL=redis://redis:6379/1
TEST_CKAN_REDIS_URL=redis://redis:6379/1

# DataPusher+ (ckanext-datapusher_plus)
# DPP 3.x runs its ingest flow through Prefect - see the `prefect` and `ckan-worker`
# services in the compose files. PREFECT_API_URL is set per-service in compose, not here.
# ckan/docker-entrypoint.d/10_datapusher_plus_prep.sh writes every ckanext.datapusher_plus.*
# key below into ckan.ini on startup; unset vars are written as empty and override DPP's
# built-in defaults, so set the ones you care about explicitly.
#
# The DP+ service-account API token (used to POST job status to /api/3/action/datapusher_hook,
# which is sysadmin-only) is minted automatically by 15_datapusher_plus_token.sh and stored
# as ckanext.datapusher_plus.api_token in the shared ckan.ini. Only set this to pin a
# specific token:
# CKANEXT__DATAPUSHER_PLUS__API_TOKEN=
CKANEXT__DATAPUSHER_PLUS__QSV_BIN=/usr/local/bin/qsvdp
CKANEXT__DATAPUSHER_PLUS__FILE_BIN=/usr/bin/file
CKANEXT__DATAPUSHER_PLUS__SSL_VERIFY=False
CKANEXT__DATAPUSHER_PLUS__UPLOAD_LOG_LEVEL=INFO
CKANEXT__DATAPUSHER_PLUS__DOWNLOAD_TIMEOUT=300
CKANEXT__DATAPUSHER_PLUS__MAX_CONTENT_LENGTH=1256000000
CKANEXT__DATAPUSHER_PLUS__CHUNK_SIZE=16384
CKANEXT__DATAPUSHER_PLUS__DEFAULT_EXCEL_SHEET=0
CKANEXT__DATAPUSHER_PLUS__PREVIEW_ROWS=1000
CKANEXT__DATAPUSHER_PLUS__IGNORE_FILE_HASH=True
CKANEXT__DATAPUSHER_PLUS__AUTO_INDEX_THRESHOLD=5000
CKANEXT__DATAPUSHER_PLUS__AUTO_INDEX_DATES=True
CKANEXT__DATAPUSHER_PLUS__AUTO_UNIQUE_INDEX=True
CKANEXT__DATAPUSHER_PLUS__AUTO_ALIAS=True
CKANEXT__DATAPUSHER_PLUS__AUTO_ALIAS_UNIQUE=False
CKANEXT__DATAPUSHER_PLUS__ADD_SUMMARY_STATS_RESOURCE=False
CKANEXT__DATAPUSHER_PLUS__SUMMARY_STATS_WITH_PREVIEW=False
CKANEXT__DATAPUSHER_PLUS__PII_SCREENING=False
CKANEXT__DATAPUSHER_PLUS__PII_FOUND_ABORT=False
CKANEXT__DATAPUSHER_PLUS__PII_SHOW_CANDIDATES=False
CKANEXT__DATAPUSHER_PLUS__PII_QUICK_SCREEN=False
CKANEXT__DATAPUSHER_PLUS__PREFER_DMY=False
CKANEXT__DATAPUSHER_PLUS__SORT_AND_DUPE_CHECK=True
CKANEXT__DATAPUSHER_PLUS__DEDUP=True
CKANEXT__DATAPUSHER_PLUS__UNSAFE_PREFIX=_
CKANEXT__DATAPUSHER_PLUS__RESERVED_COLNAMES=_id
CKANEXT__DATAPUSHER_PLUS__AUTO_SPATIAL_SIMPLICATION=True
CKANEXT__DATAPUSHER_PLUS__SPATIAL_SIMPLICATION_RELATIVE_TOLERANCE=0.1
CKANEXT__DATAPUSHER_PLUS__LATITUDE_FIELDS=latitude,lat
CKANEXT__DATAPUSHER_PLUS__LONGITUDE_FIELDS=longitude,lon,lng,long
CKANEXT__DATAPUSHER_PLUS__AUTO_UNZIP_ONE_FILE=True

# Legacy DataPusher (only used if you swap `datapusher_plus` back to `datapusher` above)
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# NGINX
NGINX_PORT=80
NGINX_SSLPORT=443

# Extensions
CKAN__PLUGINS="image_view text_view datatables_view datastore datapusher_plus envvars"
CKAN__HARVEST__MQ__TYPE=redis
CKAN__HARVEST__MQ__HOSTNAME=redis
CKAN__HARVEST__MQ__PORT=6379
CKAN__HARVEST__MQ__REDIS_DB=1
